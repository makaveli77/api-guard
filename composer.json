{
    "name": "ahdev/api-guard",
    "description": "Framework-independent PHP package for comparing OpenAPI specifications and reporting breaking changes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "API Guard Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/yaml": "^6.4|^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ApiGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiGuard\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/api-guard"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@analyse"
        ]
    }
}
