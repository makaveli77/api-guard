{
    "name": "your-vendor/api-guard-pro",
    "description": "Advanced policies and CI report formats for API Guard.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^7.4",
        "your-vendor/api-guard": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ApiGuard\\Pro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiGuard\\Pro\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/api-guard-pro"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "versions": {
                    "your-vendor/api-guard": "1.0.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@analyse"
        ]
    }
}
