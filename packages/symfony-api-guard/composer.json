{
    "name": "ahdev/symfony-api-guard",
    "description": "Symfony Console and bundle integration for API Guard OpenAPI compatibility checks.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "ahdev/api-guard": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ApiGuard\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiGuard\\Symfony\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "versions": {
                    "ahdev/api-guard": "1.0.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@analyse"
        ]
    }
}
